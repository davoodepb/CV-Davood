// ============================================================
//  DAVOOD HUNTER AI OS v1.0 — TradingView Indicator
//  Trading Room Hunter (TRH) — Liquidity Trap System
//  Version: 3.0
// ============================================================
//@version=5
indicator("TRH Hunter AI v3.0", overlay=true,
          max_lines_count=500, max_labels_count=500, max_boxes_count=200)

// ─── INPUTS ──────────────────────────────────────────────────
grp1 = "Liquidity Detection"
eql_lookback  = input.int(15,    "Equal H/L Lookback",    group=grp1, minval=5, maxval=50)
eql_tolerance = input.float(0.02,"Equal Level Tolerance %",group=grp1,minval=0.001,maxval=0.3)
show_eqh      = input.bool(true, "Show Equal Highs",       group=grp1)
show_eql      = input.bool(true, "Show Equal Lows",        group=grp1)
show_sweeps   = input.bool(true, "Show Sweeps",            group=grp1)
show_pdhl     = input.bool(true, "Show Prev Day H/L",      group=grp1)

grp2 = "SMC Concepts"
show_fvg   = input.bool(true,  "Show FVG",            group=grp2)
show_ob    = input.bool(true,  "Show Order Blocks",    group=grp2)
show_bos   = input.bool(true,  "Show BOS / CHoCH",    group=grp2)
show_disp  = input.bool(true,  "Show Displacement",   group=grp2)
fvg_min    = input.float(0.03, "FVG Min Size %",      group=grp2,minval=0.01)

grp3 = "Sessions (Lisbon)"
show_kz      = input.bool(true,"Show Killzones",      group=grp3)
lon_start    = input.int(8,   "London Start h",       group=grp3)
lon_end      = input.int(11,  "London End h",         group=grp3)
ny_start     = input.int(13,  "NY Start h",           group=grp3)
ny_end       = input.int(16,  "NY End h",             group=grp3)
show_asia    = input.bool(true,"Show Asia",            group=grp3)

grp4 = "Alerts"
alert_sw   = input.bool(true,"Alert on Sweeps",       group=grp4)
alert_dp   = input.bool(true,"Alert on Displacement", group=grp4)
htf_ov     = input.string("AUTO","HTF Bias Override", group=grp4,options=["AUTO","BULLISH","BEARISH","NEUTRAL"])
wb_symbol  = input.string("XAUUSD","Webhook Symbol",  group=grp4)

// ─── COLORS ──────────────────────────────────────────────────
c_eqh = color.new(color.red,10)
c_eql = color.new(color.lime,10)
c_lon = color.new(color.blue,92)
c_ny  = color.new(color.purple,92)
c_asia= color.new(color.gray,95)

// ─── SESSIONS ────────────────────────────────────────────────
bh = hour(time,"Europe/Lisbon")
in_lon  = bh >= lon_start  and bh < lon_end
in_ny   = bh >= ny_start   and bh < ny_end
in_asia = bh >= 0          and bh < lon_start

if show_kz  and in_lon  => bgcolor(c_lon,  title="London KZ")
if show_kz  and in_ny   => bgcolor(c_ny,   title="NY KZ")
if show_asia and in_asia => bgcolor(c_asia, title="Asia")

// ─── PREV DAY H/L ────────────────────────────────────────────
[pdh,pdl] = request.security(syminfo.tickerid,"D",[high[1],low[1]],lookahead=barmerge.lookahead_on)
if show_pdhl
    line.new(bar_index-1,pdh,bar_index,pdh,color=color.new(color.red,40),width=1,style=line.style_dashed,extend=line.extend.right)
    line.new(bar_index-1,pdl,bar_index,pdl,color=color.new(color.lime,40),width=1,style=line.style_dashed,extend=line.extend.right)

// ─── PIVOTS ───────────────────────────────────────────────────
ph = ta.pivothigh(high,eql_lookback,eql_lookback)
pl = ta.pivotlow(low, eql_lookback,eql_lookback)

var float lph=na, var float lph2=na, var float lpl=na, var float lpl2=na
if not na(ph) => lph2:=lph, lph:=ph
if not na(pl) => lpl2:=lpl, lpl:=pl

wp(a,b,p)=> not na(a) and not na(b) and math.abs(a-b)/b*100<=p

eq_h = wp(lph,lph2,eql_tolerance)
eq_l = wp(lpl,lpl2,eql_tolerance)

if show_eqh and eq_h and not na(lph)
    line.new(bar_index-eql_lookback,lph,bar_index,lph,color=c_eqh,width=2,style=line.style_dotted)
    label.new(bar_index,lph,"EQH 🎯",color=c_eqh,textcolor=color.white,size=size.small,style=label.style_label_down)

if show_eql and eq_l and not na(lpl)
    line.new(bar_index-eql_lookback,lpl,bar_index,lpl,color=c_eql,width=2,style=line.style_dotted)
    label.new(bar_index,lpl,"EQL 🎯",color=c_eql,textcolor=color.black,size=size.small,style=label.style_label_up)

// ─── SWEEPS ───────────────────────────────────────────────────
sw_h = not na(lph) and high>lph and close<lph
sw_l = not na(lpl) and low<lpl  and close>lpl

if show_sweeps and sw_h
    label.new(bar_index,high,"SWEEP ↑\n🔴 SHORT?",color=color.red,textcolor=color.white,size=size.normal,style=label.style_label_down)
if show_sweeps and sw_l
    label.new(bar_index,low,"SWEEP ↓\n🟢 LONG?",color=color.lime,textcolor=color.black,size=size.normal,style=label.style_label_up)

// ─── FVG ──────────────────────────────────────────────────────
bull_fvg = low>high[2] and (low-high[2])/high[2]*100>=fvg_min
bear_fvg = high<low[2] and (low[2]-high)/low[2]*100>=fvg_min
if show_fvg and bull_fvg
    box.new(bar_index-2,high[2],bar_index+20,low,bgcolor=color.new(color.teal,80),border_color=color.teal,border_width=1)
if show_fvg and bear_fvg
    box.new(bar_index-2,high,bar_index+20,low[2],bgcolor=color.new(color.orange,80),border_color=color.orange,border_width=1)

// ─── ATR + DISPLACEMENT ───────────────────────────────────────
atr_v  = ta.atr(14)
body   = math.abs(close-open)
d_bull = close>open and body>atr_v*0.6 and close>high[1]
d_bear = close<open and body>atr_v*0.6 and close<low[1]

if show_disp and d_bull
    label.new(bar_index,low,"D▲",color=color.new(color.lime,60),textcolor=color.black,size=size.tiny,style=label.style_label_up)
if show_disp and d_bear
    label.new(bar_index,high,"D▼",color=color.new(color.red,60),textcolor=color.white,size=size.tiny,style=label.style_label_down)

// ─── ORDER BLOCKS ─────────────────────────────────────────────
bull_ob = d_bull and close[1]<open[1]
bear_ob = d_bear and close[1]>open[1]
if show_ob and bull_ob
    box.new(bar_index-1,low[1],bar_index+30,high[1],bgcolor=color.new(color.teal,70),border_color=color.teal,border_width=1)
if show_ob and bear_ob
    box.new(bar_index-1,low[1],bar_index+30,high[1],bgcolor=color.new(color.red,70),border_color=color.red,border_width=1)

// ─── BOS / CHoCH ──────────────────────────────────────────────
bull_bos   = not na(lph) and ta.crossover(close,lph)
bear_bos   = not na(lpl) and ta.crossunder(close,lpl)
bull_choch = bull_bos and sw_l[1]
bear_choch = bear_bos and sw_h[1]

if show_bos
    if bull_choch
        label.new(bar_index,low,"CHoCH▲",color=color.teal,textcolor=color.white,size=size.small,style=label.style_label_up)
    else if bull_bos
        label.new(bar_index,low,"BOS▲",color=color.new(color.teal,30),textcolor=color.white,size=size.tiny,style=label.style_label_up)
    if bear_choch
        label.new(bar_index,high,"CHoCH▼",color=color.red,textcolor=color.white,size=size.small,style=label.style_label_down)
    else if bear_bos
        label.new(bar_index,high,"BOS▼",color=color.new(color.orange,30),textcolor=color.white,size=size.tiny,style=label.style_label_down)

// ─── SESSION H/L ──────────────────────────────────────────────
var float sh=na, var float sl_=na
nd = ta.change(time("D"))!=0
if nd => sh:=high, sl_:=low
else   => sh:=math.max(sh,high), sl_:=math.min(sl_,low)
plot(sh,"Sess High",color=color.new(color.red,70),linewidth=1)
plot(sl_,"Sess Low", color=color.new(color.lime,70),linewidth=1)

// ─── BIAS ─────────────────────────────────────────────────────
ema20 = ta.ema(close,20)
ema50 = ta.ema(close,50)
ab    = ema20>ema50?"BULLISH":ema20<ema50?"BEARISH":"NEUTRAL"
bias  = htf_ov=="AUTO"?ab:htf_ov
plot(ema20,"EMA20",color=color.new(color.yellow,60),linewidth=1)
plot(ema50,"EMA50",color=color.new(color.white,70),linewidth=1)

// ─── CONFLUENCE SCORE ─────────────────────────────────────────
ls = (eq_l?2:0)+(sw_l?3:0)+(d_bull?2:0)+(bull_fvg?1:0)+(bull_bos?1:0)+((in_lon or in_ny)?2:0)+(bias=="BULLISH"?1:0)
ss = (eq_h?2:0)+(sw_h?3:0)+(d_bear?2:0)+(bear_fvg?1:0)+(bear_bos?1:0)+((in_lon or in_ny)?2:0)+(bias=="BEARISH"?1:0)
mx = 12

// ─── INFO TABLE ──────────────────────────────────────────────
var table tb = table.new(position.top_right,2,10,bgcolor=color.new(color.black,75),border_color=color.new(color.gray,50),border_width=1)
if barstate.islast
    kzt = in_lon?"🔵 LONDON":in_ny?"🟣 NEW YORK":in_asia?"⚫ ASIA":"⚫ OFF"
    kzc = in_lon?color.blue:in_ny?color.purple:color.gray
    lp  = math.round(ls/mx*100)
    sp  = math.round(ss/mx*100)
    bt  = ls>=ss?"🟢 LONG":"🔴 SHORT"
    bc  = ls>=ss?color.lime:color.red
    table.cell(tb,0,0,"DAVOOD HUNTER AI",bold=true,text_color=color.orange,bgcolor=color.new(color.orange,85),text_size=size.small)
    table.cell(tb,1,0,"TRH v3.0",text_color=color.orange,bgcolor=color.new(color.orange,85),text_size=size.small)
    table.cell(tb,0,1,"Session",text_color=color.white,text_size=size.small)
    table.cell(tb,1,1,kzt,text_color=kzc,text_size=size.small)
    table.cell(tb,0,2,"HTF Bias",text_color=color.white,text_size=size.small)
    table.cell(tb,1,2,bias,text_color=bias=="BULLISH"?color.lime:bias=="BEARISH"?color.red:color.gray,text_size=size.small)
    table.cell(tb,0,3,"Best Setup",text_color=color.white,text_size=size.small)
    table.cell(tb,1,3,bt,text_color=bc,text_size=size.small)
    table.cell(tb,0,4,"Long Score",text_color=color.white,text_size=size.small)
    table.cell(tb,1,4,str.tostring(ls)+"/"+str.tostring(mx)+" ("+str.tostring(lp)+"%)",text_color=lp>=70?color.lime:lp>=40?color.yellow:color.gray,text_size=size.small)
    table.cell(tb,0,5,"Short Score",text_color=color.white,text_size=size.small)
    table.cell(tb,1,5,str.tostring(ss)+"/"+str.tostring(mx)+" ("+str.tostring(sp)+"%)",text_color=sp>=70?color.red:sp>=40?color.yellow:color.gray,text_size=size.small)
    table.cell(tb,0,6,"EQL/Sweep",text_color=color.white,text_size=size.small)
    table.cell(tb,1,6,(eq_l?"EQL✓ ":"")+(sw_l?"SWEPT🎯":"—"),text_color=sw_l?color.lime:color.gray,text_size=size.small)
    table.cell(tb,0,7,"EQH/Sweep",text_color=color.white,text_size=size.small)
    table.cell(tb,1,7,(eq_h?"EQH✓ ":"")+(sw_h?"SWEPT🎯":"—"),text_color=sw_h?color.red:color.gray,text_size=size.small)
    table.cell(tb,0,8,"Displacement",text_color=color.white,text_size=size.small)
    table.cell(tb,1,8,d_bull?"▲ BULL":d_bear?"▼ BEAR":"none",text_color=d_bull?color.lime:d_bear?color.red:color.gray,text_size=size.small)
    table.cell(tb,0,9,"ATR",text_color=color.white,text_size=size.small)
    table.cell(tb,1,9,str.tostring(math.round(atr_v,2)),text_color=color.yellow,text_size=size.small)

// ─── WEBHOOK ALERTS ───────────────────────────────────────────
sn = in_lon?"London":in_ny?"NewYork":"None"

lj = '{"symbol":"'+wb_symbol+'","event":"liquidity_sweep_low","price":'+str.tostring(close)+',"session":"'+sn+'","timeframe":"'+timeframe.period+'","htf_bias":"'+bias+'","liquidity_level":'+str.tostring(math.round(nz(lpl),2))+',"atr":'+str.tostring(math.round(atr_v,2))+',"swept_low":true,"closed_back_inside":true,"displacement_candle":'+str.tostring(d_bull)+',"fvg_present":'+str.tostring(bull_fvg)+',"bos_confirmed":'+str.tostring(bull_bos)+',"score_hint":'+str.tostring(ls)+',"notes":"EQL swept in '+sn+' KZ"}'

sj = '{"symbol":"'+wb_symbol+'","event":"liquidity_sweep_high","price":'+str.tostring(close)+',"session":"'+sn+'","timeframe":"'+timeframe.period+'","htf_bias":"'+bias+'","liquidity_level":'+str.tostring(math.round(nz(lph),2))+',"atr":'+str.tostring(math.round(atr_v,2))+',"swept_high":true,"closed_back_inside":true,"displacement_candle":'+str.tostring(d_bear)+',"fvg_present":'+str.tostring(bear_fvg)+',"bos_confirmed":'+str.tostring(bear_bos)+',"score_hint":'+str.tostring(ss)+',"notes":"EQH swept in '+sn+' KZ"}'

if alert_sw and sw_l and (in_lon or in_ny) => alert(lj, alert.freq_once_per_bar_close)
if alert_sw and sw_h and (in_lon or in_ny) => alert(sj, alert.freq_once_per_bar_close)
