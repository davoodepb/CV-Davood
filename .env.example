# ============================================================
#  DAVOOD HUNTER AI OS v1.0 — Environment Variables
#  Copy this file to .env and add your real keys
#  NEVER share .env or commit to GitHub
# ============================================================

# ─── AI KEYS (add whichever you have) ───────────────────────
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE
GROQ_API_KEY=gsk_YOUR_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY

# ─── BROKER ─────────────────────────────────────────────────
BROKER=paper
EXCHANGE_API_KEY=YOUR_EXCHANGE_KEY
EXCHANGE_SECRET=YOUR_EXCHANGE_SECRET

# ─── ALWAYS TRUE UNTIL 30-DAY PAPER VALIDATION ──────────────
PAPER_MODE=true

# ─── SECURITY ────────────────────────────────────────────────
WEBHOOK_SECRET=trh_hunter_secret_change_this

# ─── TELEGRAM (optional) ─────────────────────────────────────
TELEGRAM_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
