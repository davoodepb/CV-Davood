# ============================================================
#  CV-Davood — Environment Variables
#  Copy this file to .env and add your real values
#  NEVER share .env or commit it to GitHub
# ============================================================

# ─── Frontend (Vite) ─────────────────────────────────────────
# Admin email — pre-fills login form and enables admin role
VITE_ADMIN_EMAIL=your-admin@gmail.com

# Stripe checkout URL for shop (optional)
VITE_STRIPE_CHECKOUT_URL=https://your-stripe-checkout-link

# ─── Trading Bot (Python - main.py) ──────────────────────────
# These are NOT needed for the website frontend
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE
GROQ_API_KEY=gsk_YOUR_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY

BROKER=paper
EXCHANGE_API_KEY=YOUR_EXCHANGE_KEY
EXCHANGE_SECRET=YOUR_EXCHANGE_SECRET
PAPER_MODE=true

WEBHOOK_SECRET=trh_hunter_secret_change_this

TELEGRAM_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ─── Social Media Agent (Node.js) ────────────────────────────
# These are NOT needed for the website frontend
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=
# COMPOSIO_API_KEY=
